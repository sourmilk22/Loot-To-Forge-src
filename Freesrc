    -- Sweep and guarantee all checkbox frames have clean white borders
    local function applyAllToggleBorders()
        pcall(function()
            local holder = Library and Library.Holder and Library.Holder.Instance
            if not holder then return end
            for _, desc in ipairs(holder:GetDescendants()) do
                if desc:IsA("Frame") and (desc.Size.X.Offset == 18 or desc.Size.X.Offset == 21) and desc:FindFirstChildOfClass("UICorner") then
                    if desc.Parent and desc.Parent:IsA("GuiButton") and not desc:FindFirstChild("LucyToggleStroke") then
                        local stroke = Instance.new("UIStroke")
                        stroke.Name = "LucyToggleStroke"
                        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                        stroke.Color = Color3.fromRGB(240, 240, 240)
                        stroke.Thickness = 1.2
                        stroke.Transparency = 0.15
                        stroke.LineJoinMode = Enum.LineJoinMode.Round
                        stroke.Parent = desc
                    end
                end
            end
        end)
    end
    applyAllToggleBorders()
    task.defer(applyAllToggleBorders)
    task.delay(0.5, applyAllToggleBorders)
    task.delay(1.5, applyAllToggleBorders)

    -- Sweep and guarantee mobile font sizes on all elements (Mobile ONLY)
    local function applyMobileFontHierarchy()
        if not isMobileMode then return end
        pcall(function()
            local holder = Library and Library.Holder and Library.Holder.Instance
            if not holder then return end
            for _, desc in ipairs(holder:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                    local txt = desc.Text or ""
                    -- 1. หัวข้อหลัก 22 (Main Titles)
                    if txt == "Lucy HUB" or (desc.Position.Y.Offset == 10 and desc.TextSize < 22) then
                        desc.TextSize = 22
                    -- 2. ข้อความย่อย 18 (Sub Text)
                    elseif txt == "Free Version" or (desc:IsA("TextBox") and desc.TextSize < 18 and desc.Size.X.Offset < 70) then
                        desc.TextSize = 18
                    -- 3. ข้อความฟังก์ชันหลัก 20 (Main Function Text)
                    elseif #txt > 0 and desc.TextSize < 20 and desc.TextSize >= 12 then
                        desc.TextSize = 20
                    end
                end
            end
        end)
    end
    if isMobileMode then
        applyMobileFontHierarchy()
        task.defer(applyMobileFontHierarchy)
        task.delay(0.5, applyMobileFontHierarchy)
        task.delay(1.5, applyMobileFontHierarchy)
    end

