        local ready, curRebirth, curLevel, needLevel, isMax = checkRebirthStatus()
        local statusTxt = "เลเวลยังไม่ถึงเกณฑ์"
        if isMax then statusTxt = "ระดับ Rebirth สูงสุดแล้ว (Max)"
        elseif ready then statusTxt = "พร้อมเกิดใหม่แล้ว!"
        elseif needLevel == 0 then statusTxt = "กำลังโหลดข้อมูล..." end

        local txt = string.format("ระดับ Rebirth ปัจจุบัน: %d | เลเวล: %d / %d [%s]",
            curRebirth, curLevel, needLevel, statusTxt)
        if UIControls.RebirthStatusLabel and UIControls.RebirthStatusLabel.SetText then
            UIControls.RebirthStatusLabel:SetText(txt)
        end
    end)
end

