launchMainHub = function(deviceMode)
    -- Enforce matching device at the API level (PC cannot run Mobile, Mobile cannot run PC)
    local actualDevice = getActualDevice()
    if deviceMode ~= actualDevice then
        warn(string.format("[Lucy HUB] Blocked %s mode on %s client! Forcing %s mode.", tostring(deviceMode), tostring(actualDevice), tostring(actualDevice)))
        deviceMode = actualDevice
    end

    local isMobileMode = (deviceMode == "Mobile")
    local scaleVal = isMobileMode and 0.85 or 1.0
    -- PC Mode: enlarged by 30% (736*1.30 = 956.8 -> 957, 520*1.30 = 676)
    -- Mobile Mode: enlarged by another 40% (602*1.40 = 842.8 -> 843, 378*1.40 = 529.2 -> 529)
    local winSize = isMobileMode and UDim2.fromOffset(843, 529) or UDim2.fromOffset(957, 676)

    -- Force MentalityUI to mount into PlayerGui on Mobile / Delta
    if isMobileMode or isMobileClient then
        gethui = function()
            return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 25)
        end
    end

    local Library = nil
    local codeStr = nil

    -- 1. Try local executor disk cache (Instant load & offline/rate-limit bypass)
    pcall(function()
        if isfile and readfile and isfile("LucyHub_MentalityUI.lua") then
            local cached = readfile("LucyHub_MentalityUI.lua")
            if cached and #cached > 30000 and string.find(cached, "Library") and not string.find(cached, "<!DOCTYPE") then
                codeStr = cached
            end
        end
    end)

    -- 2. If not cached, download from GitHub raw first (High speed CDN, no rate limit), then dpaste fallback
    if not codeStr then
        local sources = {
            "https://raw.githubusercontent.com/samuraa1/MentalityUI/main/Library.lua",
            "https://dpaste.com/EMAHR4D29.txt"
        }
        for _, url in ipairs(sources) do
            for attempt = 1, 3 do
                local okLib, res = pcall(function()
                    return game:HttpGet(url)
                end)
                if okLib and res and #res > 30000 and string.find(res, "Library") and not string.find(res, "<!DOCTYPE") then
                    codeStr = res
                    pcall(function()
                        if writefile then writefile("LucyHub_MentalityUI.lua", codeStr) end
                    end)
                    break
                end
                task.wait(0.5)
            end
            if codeStr then break end
        end
    end

    local function patchMentalityUISource(src)
        if not src or type(src) ~= "string" then return src end
        local target = 'Items["Indicator"]:AddToTheme({BackgroundColor3 = "Element"})'
        local strokeInject = target .. [[

                Instances:Create("UIStroke", {
                    Parent = Items["Indicator"].Instance,
                    Name = "LucyToggleStroke",
                    Color = FromRGB(240, 240, 240),
                    Thickness = 1.2,
                    Transparency = 0.15,
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                    LineJoinMode = Enum.LineJoinMode.Round
                })]]
        if string.find(src, target, 1, true) and not string.find(src, "LucyToggleStroke", 1, true) then
            src = string.gsub(src, target, strokeInject, 1)
        end
        return src
    end

    local function patchMobileFonts(src)
        if not src or type(src) ~= "string" then return src end

        -- 1. หัวข้อหลัก 22 (Main Titles: Window Title & Section Title)
        src = src:gsub('(Items%["Title"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Window%.Name.-TextSize%s*=%s*)16,', '%122,')
        src = src:gsub('(Items%["Title"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Section%.Name.-TextSize%s*=%s*)15,', '%122,')

        -- 2. ข้อความฟังก์ชันหลัก 20 (Main Function Text: Tabs, Toggles, Buttons, Sliders, Dropdowns, Keybinds)
        src = src:gsub('(Items%["Text"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Page%.Name.-TextSize%s*=%s*)14,', '%120,')
        src = src:gsub('(Items%["Text"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Toggle%.Name.-TextSize%s*=%s*)14,', '%120,')
        src = src:gsub('(Size%s*=%s*UDim2New%(1,%s*0,%s*0,%s*)18%)', '%124)')
        src = src:gsub('(Items%["Text"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Button%.Name.-TextSize%s*=%s*)14,', '%120,')
        src = src:gsub('(Items%["Text"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Slider%.Name.-TextSize%s*=%s*)14,', '%120,')
        src = src:gsub('(Items%["Text"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Dropdown%.Name.-TextSize%s*=%s*)14,', '%120,')
        src = src:gsub('(Items%["Text"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Keybind%.Name.-TextSize%s*=%s*)14,', '%120,')

        -- 3. ข้อความย่อย 18 (Sub Text: Window SubName, Section Description, Values, Dropdown Options, Search)
        src = src:gsub('(Items%["SubTitle"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Window%.SubName.-TextSize%s*=%s*)14,', '%118,')
        src = src:gsub('(Items%["Description"%]%s*=%s*Instances:Create%("TextLabel",.-Text%s*=%s*Section%.Description.-TextSize%s*=%s*)15,', '%118,')
        src = src:gsub('(Items%["Value"%]%s*=%s*Instances:Create%("TextBox",.-TextSize%s*=%s*)14,', '%118,')
        src = src:gsub('(Items%["RealDropdown"%]%s*=%s*Instances:Create%("TextButton",.-TextSize%s*=%s*)14,', '%118,')
        src = src:gsub('(OptionText%s*=%s*Instances:Create%("TextLabel",.-TextSize%s*=%s*)14,', '%118,')
        src = src:gsub('(Items%["SearchField"%]%s*=%s*Instances:Create%("TextBox",.-TextSize%s*=%s*)13,', '%118,')
        src = src:gsub('(Items%["ModeSelect"%]%s*=%s*Instances:Create%("TextButton",.-TextSize%s*=%s*)13,', '%118,')

        return src
    end

    if codeStr then
        codeStr = patchMentalityUISource(codeStr)
        if isMobileMode then
            codeStr = patchMobileFonts(codeStr)
        end
        local okExec, lib = pcall(function() return loadstring(codeStr)() end)
        if okExec and lib then
            Library = lib
        end
    end

    -- Hook Section.Toggle to ensure all checkboxes receive crisp white border in all environments
    if Library and Library.Sections and Library.Sections.Toggle then
        local rawToggle = Library.Sections.Toggle
        Library.Sections.Toggle = function(self, Data)
            local toggleObj = rawToggle(self, Data)
            pcall(function()
                local content = self.Items and self.Items["Content"] and self.Items["Content"].Instance
                if content then
                    for _, btn in ipairs(content:GetChildren()) do
                        if btn:IsA("GuiButton") then
                            for _, child in ipairs(btn:GetChildren()) do
                                if child:IsA("Frame") and (child.Size.X.Offset == 18 or child.Size.X.Offset == 21) and child:FindFirstChildOfClass("UICorner") then
                                    if not child:FindFirstChild("LucyToggleStroke") then
                                        local stroke = Instance.new("UIStroke")
                                        stroke.Name = "LucyToggleStroke"
                                        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                                        stroke.Color = Color3.fromRGB(240, 240, 240)
                                        stroke.Thickness = 1.2
                                        stroke.Transparency = 0.15
                                        stroke.LineJoinMode = Enum.LineJoinMode.Round
                                        stroke.Parent = child
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            return toggleObj
        end
    end

    if not Library then
        warn("[Lucy HUB] Error loading MentalityUI after retries")
        pcall(function()
            local container = getGuiContainer()
            local errSg = Instance.new("ScreenGui")
            errSg.Name = "LucyHub_Error"
            errSg.ResetOnSpawn = false
            errSg.DisplayOrder = 999999999
            local fr = Instance.new("Frame")
            fr.Size = UDim2.fromOffset(360, 90)
            fr.Position = UDim2.new(0.5, -180, 0.2, 0)
            fr.BackgroundColor3 = Color3.fromRGB(30, 15, 20)
            local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 10) c.Parent = fr
            local lb = Instance.new("TextLabel")
            lb.Size = UDim2.new(1, -20, 1, -20)
            lb.Position = UDim2.new(0, 10, 0, 10)
            lb.TextColor3 = Color3.fromRGB(255, 100, 120)
            lb.Text = "[Lucy HUB Error]\nไม่สามารถดาวน์โหลด UI ได้ กรุณาตรวจสอบอินเทอร์เน็ต"
            lb.TextWrapped = true
            lb.BackgroundTransparency = 1
            lb.Parent = fr
            fr.Parent = errSg
            errSg.Parent = container
            task.delay(6, function() pcall(function() errSg:Destroy() end) end)
        end)
        return
    end

